# Template for apps/api/.env. Copy this file to .env and replace every value.
# This file IS committed to Git, so it must only ever contain fake placeholder values.

# Postgres connection URL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# On your laptop, use Railway's DATABASE_PUBLIC_URL (host ends in proxy.rlwy.net).
# On Railway itself, use the private DATABASE_URL (host ends in .railway.internal).
DATABASE_URL="postgresql://postgres:your-password@your-host.proxy.rlwy.net:12345/railway"

# Secret the admin types on /submissions. GET /requests rejects any request without it.
ADMIN_KEY="replace-with-a-long-random-string"

# The web app's address. The API only accepts browser requests coming from here.
CORS_ORIGIN="http://localhost:3000"

# Which port the API listens on. Railway sets this automatically in production.
PORT=3001

# Password for the three sample accounts (user@, admin@, developer@example.com) that
# `npx prisma db seed` creates. At least 8 characters. Use a different one on every machine
# and a strong one anywhere public, or anyone could log in as the sample admin.
SEED_PASSWORD="replace-with-a-test-password"

# Signs login tokens. Anyone who knows it can forge a login for any account, so make it long
# and random: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
