# Template for apps/web/.env.local. Copy this file to .env.local and adjust the value.
# This file IS committed to Git, so it must only ever contain placeholder values.

# Where the API lives. Locally that's the Nest app in apps/api (port 3001); on Vercel it
# will be the Railway URL. The NEXT_PUBLIC_ prefix copies this value into the JavaScript
# sent to every visitor's browser, so it must never hold a secret such as ADMIN_KEY.
NEXT_PUBLIC_API_URL="http://localhost:3001"
